{
  "name": "linnya-formal-sandbox-runner-validation",
  "version": "1.0.0",
  "private": true,
  "description": "Packaged validation for the production Electron Sandbox scope",
  "author": "Linnya",
  "main": "main.cjs",
  "build": {
    "appId": "com.linnyai.formal-sandbox-runner-validation",
    "productName": "Linnya Formal Sandbox Runner Validation",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false
    },
    "files": [
      "main.cjs",
      "sandbox/sandboxUtilityProcess.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "headless-node-runtime/darwin/arm64",
        "to": "headless-node-runtime/darwin/arm64"
      },
      {
        "from": "sandbox/sandboxEvaluatorProcess.cjs",
        "to": "sandbox-runtime/evaluator/sandboxEvaluatorProcess.cjs"
      }
    ],
    "mac": {
      "target": "dir",
      "identity": "-"
    }
  }
}
