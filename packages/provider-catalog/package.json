{
  "name": "@linnya/provider-catalog",
  "version": "0.1.0",
  "description": "Linnya product provider catalog, audited runtime bindings, and upstream synchronization.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime-bindings": {
      "types": "./dist/runtime-bindings.d.ts",
      "import": "./dist/runtime-bindings.js",
      "require": "./dist/runtime-bindings.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "sync": "tsx bin/provider-catalog-sync.ts",
    "sync:check": "tsx bin/provider-catalog-sync.ts --check",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack-smoke": "pnpm run build && node scripts/verifyPackedRuntime.mjs"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
