{
  "name": "@linnlabs/linnkit-provider-ai-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Optional Vercel AI SDK language inference adapter for Linnkit canonical hosts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "require": "./dist/conformance.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "conformance": "vitest run conformance",
    "conformance:affected": "node --import tsx bin/runAffectedProviderConformance.ts",
    "test": "vitest run src conformance",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.json",
    "pack-smoke": "pnpm run build && node scripts/verifyPackedRuntime.mjs"
  },
  "peerDependencies": {
    "@linnlabs/linnkit": "^0.38.0"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.66",
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/cerebras": "3.0.68",
    "@ai-sdk/cohere": "4.0.60",
    "@ai-sdk/deepinfra": "3.0.68",
    "@ai-sdk/deepseek": "3.0.64",
    "@ai-sdk/fireworks": "3.0.71",
    "@ai-sdk/google": "4.0.94",
    "@ai-sdk/groq": "4.0.60",
    "@ai-sdk/minimax": "3.0.56",
    "@ai-sdk/mistral": "4.0.63",
    "@ai-sdk/moonshotai": "3.0.68",
    "@ai-sdk/openai": "4.0.93",
    "@ai-sdk/openai-compatible": "3.0.68",
    "@ai-sdk/provider": "4.0.27",
    "@ai-sdk/togetherai": "3.0.69",
    "@ai-sdk/xai": "5.0.21",
    "@ai-sdk/zai": "3.0.30",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.140",
    "ai-sdk-ollama": "4.5.0"
  },
  "devDependencies": {
    "@linnlabs/linnkit": "0.40.0",
    "@types/node": "^24.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12",
    "zod": "^3.25.76"
  }
}
