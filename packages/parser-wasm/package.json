{
  "name": "parser-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "WebAssembly Markdown parser runtime used by Linnya",
  "exports": {
    ".": {
      "types": "./pkg/parser_wasm.d.ts",
      "import": "./pkg/parser_wasm.js",
      "default": "./pkg/parser_wasm.js"
    }
  },
  "files": [
    "pkg",
    "pkg-node",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node",
    "build:web": "wasm-pack build --target web --out-dir pkg",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node"
  }
}
