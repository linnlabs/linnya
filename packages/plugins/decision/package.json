  },
  "dependencies": {"@app/schemas": "workspace:*", "zod": "^3.25.76"},
  "devDependencies": {
    "@linnlabs/linnkit": "0.38.1",
    "@linnya/plugin-host-contract": "workspace:*",
    "@types/node": "^24.0.0",
    "better-sqlite3": "13.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
