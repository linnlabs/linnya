{
  "name": "@plugin/decision",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Linnya decision prototype",
  "linnya": {"development": {"backendLoading": "disk", "backendWatchConfig": "tsup.plugin.config.ts"}},
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./backend": "./src/backend/index.ts"
  },
  "scripts": {
    "build:backend": "tsup --config tsup.plugin.config.ts",
    "build": "pnpm run build:backend",
