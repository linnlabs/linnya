{
  "id": "knowledge",
  "version": "0.1.0",
  "name": "知识库",
  "description": "管理资料、检索知识并在项目中关联使用。",
  "developer": "Linnya",
  "details": [
    "保存资料原文与检索索引，支持项目关联、知识检索和引用。",
    "停用保留资料与历史证据；恢复启用后可继续使用。"
  ],
  "entry": {
    "backend": "./dist/backend/index.cjs",
    "renderer": "./dist/renderer/index.js"
  },
  "dependsOn": [
    "platform"
  ],
  "skills": [
    {
      "name": "knowledge-management",
      "description": "查看当前项目的知识库、导入或删除资料、重建索引和解除项目关联。"
    }
  ],
  "compat": {
    "minApp": "0.2.1",
    "rendererUi": "^3.5.0"
  },
  "applicationSurfaceSlot": "knowledge-base",
  "ownedTables": [
    "knowledge_bases",
    "kb_documents",
    "project_knowledge_base_links",
    "knowledge_graph_nodes",
    "knowledge_graph_edges",
    "knowledge_graph_doc_status",
    "knowledge_graph_index_status",
    "knowledge_graph_vector_doc_status"
  ],
  "dataStorage": {
    "legacyRoots": ["KnowledgeBase"],
    "directories": {
      "source": ["source_of_truth", "originals"],
      "derived": ["qdrant/storage"],
      "runtime": [
        "qdrant",
        "qdrant/logs",
        "qdrant/config",
        "qdrant/static",
        "qdrant/snapshots",
        "temporary",
        "diagnostics"
      ]
    },
    "userDataTables": ["kb_documents"]
  },
  "migrations": [
    {
      "version": 1,
      "description": "Adopt knowledge documents, project links and graph tables in place"
    }
  ]
}
