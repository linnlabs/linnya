{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@app/schemas": [
        "packages/schemas/src/index.ts"
      ],
      "@app/schemas/*": [
        "packages/schemas/src/*"
      ],
      "@plugin/backend/*": [
        "packages/plugin-host-contract/backend/*.ts"
      ],
      "@plugin/renderer/*": [
        "packages/plugin-host-contract/renderer/*.ts"
      ],
      "@app/localization": [
        "packages/plugin-host-contract/renderer/localization.ts"
      ],
      "@linnya/foundation": [
        "packages/foundation/src/index.ts"
      ],
      "@plugin/knowledge/shared": [
        "packages/plugins/knowledge/src/shared/index.ts"
      ]
    },
    "allowJs": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ]
}
