{
  "name": "@plugin/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Linnya knowledge base plugin",
  "exports": {
    "./shared": "./src/shared/index.ts",
    "./renderer": "./src/renderer/index.ts"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:backend": "node scripts/build/cleanBackend.mjs && tsup --config scripts/tsup.plugin.config.ts",
    "build:renderer": "vite build --config scripts/vite.plugin.config.mts",
    "build": "pnpm run build:backend && pnpm run build:renderer",
    "guard:artifact": "node scripts/verify-artifact.mjs",
    "package:artifact": "pnpm run build && node ../../../scripts/release/package-plugin-artifact.mjs knowledge && pnpm run guard:artifact"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "zod": "^4.6.7",
    "@linnya/foundation": "workspace:*",
    "vue": "^3.5.44",
    "pinia": "^3.0.4",
    "open-simplex-noise": "^2.5.0",
    "uuid": "^11.1.1",
    "@qdrant/js-client-rest": "^1.15.0",
    "@node-rs/jieba": "^2.0.1",
    "adler-32": "^1.3.1",
    "iconv-lite": "^0.6.3",
    "crc-32": "^1.2.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@linnya/plugin-host-contract": "workspace:*",
    "@linnya/renderer-ui": "workspace:*",
    "vue-tsc": "~3.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tsup": "^8.0.0",
    "vite": "^6.2.0"
  },
  "peerDependencies": {
    "@linnya/renderer-ui": "^3.5.0"
  },
  "linnya": {
    "development": {
      "backendLoading": "disk",
      "backendWatchConfig": "scripts/tsup.plugin.config.ts",
      "additionalBuilds": [
        {
          "id": "renderer",
          "type": "configured",
          "builder": "vite",
          "config": "scripts/vite.plugin.config.mts"
        }
      ],
      "requiredOutputs": [
        "dist/backend/index.cjs",
        "dist/backend/workers/knowledgeIngestion.worker.cjs",
        "dist/backend/workers/graphExtraction.worker.cjs",
        "dist/backend/workers/graphIndexing.worker.cjs",
        "dist/renderer/index.js",
        "dist/renderer/renderer-stylesheets.json"
      ]
    },
    "release": {
      "includeInOfficialRelease": true,
      "productionDistDirectories": [
        "dist/backend",
        "dist/renderer"
      ]
    }
  }
}
