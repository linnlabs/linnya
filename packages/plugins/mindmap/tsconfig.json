{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@plugin/mindmap/shared": ["packages/plugins/mindmap/src/shared/index.ts"],
      "@plugin/mindmap/backend": ["packages/plugins/mindmap/src/backend/index.ts"],
      "@plugin/mindmap/renderer": ["packages/plugins/mindmap/src/renderer/index.ts"],
      "@plugin/backend/*": [
        "packages/plugin-host-contract/backend/*.ts"
      ],
      "@plugin/renderer/*": [
        "packages/plugin-host-contract/renderer/*.ts"
      ],
      "@linnya/plugin-host-contract": ["packages/plugin-host-contract/index.ts"],
      "@linnya/plugin-host-contract/backend": ["packages/plugin-host-contract/backend/index.ts"],
      "@linnya/plugin-host-contract/backend/*": ["packages/plugin-host-contract/backend/*"],
      "@linnya/plugin-host-contract/renderer": ["packages/plugin-host-contract/renderer/index.ts"],
      "@linnya/plugin-host-contract/renderer/*": ["packages/plugin-host-contract/renderer/*"],
      "@plugin/*": ["src/plugin-sdk/*"],
      "@plugin/slides/shared": ["packages/plugins/slides/src/shared/index.ts"],
      "@app/localization": ["packages/plugin-host-contract/renderer/localization.ts"],
      "@app/schemas": ["packages/schemas/src/index.ts"],
      "@app/schemas/*": ["packages/schemas/src/*"]
    }
  },
  "include": ["src", "host-types/rendererEnv.d.ts"],
  "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
