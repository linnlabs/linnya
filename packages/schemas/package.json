{
  "name": "@app/schemas",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Unified schema definitions for frontend and backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/esm',{recursive:true}); fs.writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}, null, 2));\" && node scripts/fix-esm-specifiers.cjs && node scripts/verify-runtime-exports.cjs",
    "pack-smoke": "pnpm run build && node scripts/verify-packed-runtime.mjs",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "semver": "7.7.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/semver": "7.7.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/esm/index.js"
    },
    "./api-dtos": {
      "types": "./dist/api-dtos.d.ts",
      "import": "./dist/esm/api-dtos.js",
